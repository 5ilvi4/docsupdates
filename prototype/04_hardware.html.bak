        </tr>
        <tr>
          <td>3</td><td>IMU (MPU-6050 or equiv.)</td><td>Accel + gyro for wrist motion</td>
          <td class="cost-cell">$1.20</td><td>1</td><td class="cost-cell">$1.20</td>
          <td class="status-cell"><span style="background:#E6F9EF;color:var(--green)">Off-shelf</span></td>
        </tr>
        <tr>
          <td>4</td><td>nRF52840 BLE SoC</td><td>Bluetooth 5.2 LE + MCU</td>
          <td class="cost-cell">$2.90</td><td>1</td><td class="cost-cell">$2.90</td>
          <td class="status-cell"><span style="background:#E6F9EF;color:var(--green)">Off-shelf</span></td>
        </tr>
        <tr>
          <td>5</td><td>LiPo battery 120mAh</td><td>~8 hrs runtime</td>
          <td class="cost-cell">$1.50</td><td>1</td><td class="cost-cell">$1.50</td>
          <td class="status-cell"><span style="background:#E6F9EF;color:var(--green)">Off-shelf</span></td>
        </tr>
        <tr>
          <td>6</td><td>Silicone strap (child XS/S)</td><td>Wrist mount, skin-safe</td>
          <td class="cost-cell">$1.80</td><td>1</td><td class="cost-cell">$1.80</td>
          <td class="status-cell"><span style="background:#FFF3E0;color:var(--orange)">Custom mold</span></td>
        </tr>
        <tr>
          <td>7</td><td>PCB + housing</td><td>Enclosure + signal routing</td>
          <td class="cost-cell">$3.00</td><td>1</td><td class="cost-cell">$3.00</td>
          <td class="status-cell"><span style="background:#FFF3E0;color:var(--orange)">Custom</span></td>
        </tr>
        <tr>
          <td>8</td><td>USB-C magnetic charge dock</td><td>Daily charging base</td>
          <td class="cost-cell">$1.20</td><td>1</td><td class="cost-cell">$1.20</td>
          <td class="status-cell"><span style="background:#E6F9EF;color:var(--green)">Off-shelf</span></td>
        </tr>
      </tbody>
      <tfoot>
